-- ============================================================
--  HÀM LẤY JOB TỪ PREMIUM API
-- ============================================================
local function fetchPremiumJobs(keyword)
    local HttpService = game:GetService("HttpService")
    local request = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or (http and http.request)
    if not request then
        return nil
    end

    local url = API_BASE .. "/" .. keyword
    print(" Đang lấy dữ liệu...")
    
    local ok, res = pcall(function()
        return request({
            Url = url,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Roblox",
                ["Referer"] = "http://160.187.246.8:9999/"
            }
        })
    end)

    if ok and res then
        local raw = res.Body or ""
        local fixedRaw = raw
        if not string.match(raw, "^%[") then
            fixedRaw = "[" .. fixedRaw
        end
        if not string.match(raw, "%]$") then
            fixedRaw = fixedRaw .. "]"
        end
        fixedRaw = fixedRaw:gsub("}{", "},{")
        
        local success, body = pcall(function()
            return HttpService:JSONDecode(fixedRaw)
        end)
        
        if success and body then
            local jobs = {}
            local data = body
            if type(data) == "table" then
                if not data[1] then
                    local temp = {}
                    for _, v in pairs(data) do
                        if type(v) == "table" then
                            table.insert(temp, v)
                        end
                    end
                    data = temp
                end
                for _, v in ipairs(data) do
                    local job = tostring(v.Job_id or v.job_id or v.job or v.jobid or v.id or "")
                    if job ~= "" and #job > 10 then
                        job = job:gsub("[^a-f0-9%-]", "")
                        if #job > 10 then
                            table.insert(jobs, job)
                        end
                    end
                end
            end
            print(" Tìm thấy", #jobs, "job ID")
            return jobs
        else
            print(" Parse JSON thất bại!")
        end
    else
        print("!")
    end
    return nil
end

