--  HÀM LẤY JOB TỪ TAYHUB API
-- ============================================================
local function fetchTayHubJobs(keyword)
    local HttpService = game:GetService("HttpService")
    local request = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or (http and http.request)
    if not request then
        return nil
    end

    print("Đang lấy dữ liệu...")
    
    local ok, res = pcall(function()
        return request({
            Url = API_TAYHUB,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Roblox",
                ["Referer"] = "https://api-tayhub.vercel.app/"
            }
        })
    end)

    if ok and res then
        local success, body = pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        
        if success and body and body.all_servers then
            local jobs = {}
            for _, v in ipairs(body.all_servers) do
                local job = tostring(v.jobid or "")
