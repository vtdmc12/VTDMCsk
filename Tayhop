local function fetchAPI1()
    local HttpService = game:GetService("HttpService")
    local request = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or (http and http.request)
    if not request then
        return nil
    end

    local ok, res = pcall(function()
        return request({
            Url = API_1,
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Roblox",
                ["Referer"] = "https://dichvuvip2.onrender.com/"
            }
        })
    end)

    if ok and res then
        local success, body = pcall(function()
            return HttpService:JSONDecode(res.Body)
        end)
        
        if success and body and body.jobs then
            local result = {}
            for _, v in ipairs(body.jobs) do
                local j = tostring(v.job or "")
                local b = tostring(v.boss or "")
                local s = tonumber(v.sea) or 0
                local p = tonumber(v.players) or 0
                if #j > 10 then
                    table.insert(result, {job = j, boss = b, sea = s, players = p})
                end
            end
            return result
        end
    end
    return nil
end


