        if jobs1 and #jobs1 > 0 then
            print("[Hop] ", #jobs1, "server")
            return jobs1
        else
            print("[ không có dữ liệu, ")
            currentAPI = 2
        end
    end
    
    -- THỬ API 2 SAU
    if currentAPI == 2 then
        local jobs2 = fetchAPI2()
        if jobs2 and #jobs2 > 0 then
            print("[Hop] -", #jobs2, "server")
            return jobs2
        else
            print("[Hop] không có dữ liệu!")
            currentAPI = 1 -- Reset về API 1 để thử lại sau
            return nil
        end
    end
    
    return nil
end

local function fetchAllFruit()
    local allFruit = {}
    local seenJobs = {}
    
    local jobs = fetchJobs()
    if jobs then
        for _, v in ipairs(jobs) do
            local boss = tostring(v.boss or ""):lower()
            local job = tostring(v.job or "")
            local isFruit = boss:find("fruit") or boss:find("devil") or boss:find("dark") or boss:find("ghost") or boss:find("bomb") or boss:find("rocket") or boss:find("flame") or boss:find("ice") or boss:find("quake") or boss:find("light") or boss:find("love") or boss:find("spider") or boss:find("smoke") or boss:find("magma") or boss:find("sand") or boss:find("revive") or boss:find("diamond") or boss:find("rubber") or boss:find("barrier") or boss:find("gravity") or boss:find("shadow") or boss:find("venom") or boss:find("control")
            
            if isFruit and #job > 10 and job ~= game.JobId and not seenJobs[job] then
                seenJobs[job] = true
                table.insert(allFruit, {job=job, boss=v.boss, players=v.players, sea=v.sea})
            end
        end
    end
    
    return allFruit
end

local function Teleport(job)
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local TeleportService = game:GetService("TeleportService")
    local Players = game:GetService("Players")
    local Remote = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    
    pcall(function()
        Window:Notify({
            Title = "Tay hub",
            Content = "Job: " .. job,
            Image = "rbxassetid://96454140798208",
            Duration = 5
        })
    end)

    if Remote then
        local ok = pcall(function()
            Remote:InvokeServer("teleport", job)
        end)
        if ok then return true end
    end
    
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, job, Players.LocalPlayer)
    end)
    
    return ok
end

local function hopByKeyword(keyword, visitedKey, isFruit)
    local jobs = fetchJobs()
    
    if not jobs or #jobs == 0 then
        print("[Hop] ❌ Không có dữ liệu từ ")
        return false
    end
    
    local visited = _G[visitedKey] or {}
    _G[visitedKey] = visited
    
    -- DUYỆT TỪNG SERVER
    for _, v in ipairs(jobs) do
        local boss = tostring(v.boss or ""):lower()
        local job = tostring(v.job or "")
        local isMatch = false
        
        if isFruit then
            isMatch = boss:find("fruit") or boss:find("devil") or boss:find("dark") or boss:find("ghost") or boss:find("bomb") or boss:find("rocket") or boss:find("flame") or boss:find("ice") or boss:find("quake") or boss:find("light") or boss:find("love") or boss:find("spider") or boss:find("smoke") or boss:find("magma") or boss:find("sand") or boss:find("revive") or boss:find("diamond") or boss:find("rubber") or boss:find("barrier") or boss:find("gravity") or boss:find("shadow") or boss:find("venom") or boss:find("control")
        else
            isMatch = boss:find(keyword:lower())
        end
        
        if isMatch and #job > 10 and job ~= game.JobId and not visited[job] then
            visited[job] = true
            
            local displayBoss = v.boss
            local seaText = v.sea and "Sea " .. v.sea or "Unknown"
            local playerText = v.players and v.players .. "/12" or "?/12"
            
            Window:Notify({
                Title = "Tay hub",
                Content = string.format("%s | %s | %s\nJob: %s", 
                    displayBoss, seaText, playerText, job),
                Image = "rbxassetid://96454140798208",
                Duration = 5
            })
            
            print(" Tìm thấy:", displayBoss, "| Job:", job)
            
            -- THỬ TELEPORT
            local success = Teleport(job)
            if success then
                return true
            else
                print(" Teleport thất bại, tìm server khác...")
            end
        end
    end
    
    -- NẾU KHÔNG TÌM THẤY SERVER NÀO TRONG API HIỆN TẠI
    print("[Hop] dit mẹ mày")
    
    -- CHUYỂN SANG API KHÁC
    if currentAPI == 1 then
        currentAPI = 2
        print("[Hop] ")
    elseif currentAPI == 2 then
        currentAPI = 1
        print("[Hop] ")
        -- RESET VISITED KHI CHUYỂN VỀ API 1
        _G[visitedKey] = {}
    end
    
    return false
end

local function createToggle(name, keyword, visitedKey, isFruit)
    local hopping = false
    Tabs.Hop:AddToggle({
        Name = "Auto Hop " .. name,
        Default = false,
        Callback = function(Value)
            hopping = Value
            if hopping then
                print("[Hop] ", name)
                print("[Hop] ", currentAPI == 1 and "API 1 (dichvuvip2)" or "API 2 (TayHub)")
                task.spawn(function()
                    while hopping do
                        local success = hopByKeyword(keyword, visitedKey, isFruit)
                        if not success then
                            print("[Hop]  Reset visited, thử lại...")
                        end
                        task.wait(0.1)
                    end
                    print("[Hop]  Dừng:", name)
                end)
            else
                print("[Hop]  Tắt:", name)
            end
        end
    })
end

