--  HÀM LẤY JOB TỪ TẤT CẢ API (FALLBACK)
-- ============================================================
local function fetchAllJobs(keyword)
    -- THỬ PREMIUM TRƯỚC
    local jobs = fetchPremiumJobs(keyword)
    if jobs and #jobs > 0 then
        return jobs
    end
    
    -- NẾU PREMIUM LỖI, THỬ TAYHUB
    jobs = fetchTayHubJobs(keyword)
    if jobs and #jobs > 0 then
        return jobs
    end
    
    -- NẾU TAYHUB LỖI, THỬ DICHVU MỚI
    jobs = fetchDichVuJobs(keyword)
    if jobs and #jobs > 0 then
        return jobs
    end
    
    print(" đều không có dữ liệu!")
    return nil
end

-- ============================================================
--  HÀM TELEPORT
-- ============================================================
local function Teleport(job)
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local TeleportService = game:GetService("TeleportService")
    local Players = game:GetService("Players")
    local Remote = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    
    pcall(function()
        Window:Notify({
            Title = "Tay hub",
            Content = "Job: " .. job,
            Image = "rbxassetid://96454140798208",
            Duration = 5
        })
    end)

    if Remote then
        local ok = pcall(function()
            Remote:InvokeServer("teleport", job)
        end)
        if ok then return true end
    end
    
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, job, Players.LocalPlayer)
    end)
    
    return ok
end

-- ============================================================
--  HÀM HOP
-- ============================================================
local function hopByKeyword(keyword, visitedKey, isFruit)
    local jobs = fetchAllJobs(keyword)
    
    if not jobs or #jobs == 0 then
        print("[❌] Không có dữ liệu")
        return false
    end
    
    local visited = _G[visitedKey] or {}
    _G[visitedKey] = visited
    
    for _, job in ipairs(jobs) do
        if job ~= game.JobId and not visited[job] then
            visited[job] = true
            
            Window:Notify({
                Title = "Tay hub",
                Content = string.format("Job: %s", job),
                Image = "rbxassetid://96454140798208",
                Duration = 5
            })
            
            print(" teleport vào job:", job)
            
            local success = Teleport(job)
            if success then
                print("[✅] Teleport thành công!")
                return true
            else
                print("[⚠️] Teleport thất bại, thử job khác...")
            end
        end
    end
    
    _G[visitedKey] = {}
    print(" Reset visited")
    return false
end

-- ============================================================
--  TẠO TOGGLE
-- ============================================================
local function createToggle(name, keyword, visitedKey, isFruit)
    local hopping = false
    Tabs.Hop:AddToggle({
        Name = "Auto Hop " .. name,
        Default = false,
        Callback = function(Value)
            hopping = Value
            if hopping then
                print("Bắt đầu tìm:", name)
                task.spawn(function()
                    while hopping do
                        local success = hopByKeyword(keyword, visitedKey, isFruit)
                        if not success then
                            print(" visited, thử lại...")
                        end
                        task.wait(0.1)
                    end
                    print("Dừng:", name)
                end)
            else
                print(" Tắt:", name)
            end
        end
    })
end

