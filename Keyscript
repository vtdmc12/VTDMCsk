-- Hàm kiểm tra xem danh sách khóa có thực sự trống (Miễn phí) hay không
hàm cục bộ IsScriptFree()
    local hasKey = false
    for _, v in pairs(ValidKeys) do
        nếu v ~= "" và v ~= nil thì
            hasKey = true
            phá vỡ
        kết thúc
    kết thúc
    return not hasKey -- Trả về true nếu không có khóa nào hợp lệ (Chế độ MIỄN PHÍ)
kết thúc

