nếu IsScriptFree() thì
    print("🆓 Không tìm thấy key nào trong danh sách. Kích hoạt chế độ FREE!")
    Chạy tập lệnh chính()
    return -- Dừng toàn bộ code phía dưới, không hiển thị UI nữa
kết thúc

hàm cục bộ IsKeyValid(k)
    for _, v in pairs(ValidKeys) do if k == v and v ~= "" then return true end end
    trả về false
kết thúc

hàm cục bộ LoadSaved()
    nếu writefile và isfile và isfile(KeyFileName) thì
        local saved = readfile(KeyFileName)
        nếu đã lưu và IsKeyValid(saved) thì trả về true.
    kết thúc
    trả về false
kết thúc

